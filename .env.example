# ==== Apify (coleta) ====
# Token da sua conta Apify: https://console.apify.com/account/integrations
APIFY_TOKEN=apify_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ==== Entrega: Telegram ====
# Crie um bot com @BotFather e pegue o token. Depois descubra o chat_id
# enviando uma msg ao bot e abrindo https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ==== Entrega: Discord (alternativa) ====
# Server Settings > Integrations > Webhooks > New Webhook > Copy URL
DISCORD_WEBHOOK_URL=
